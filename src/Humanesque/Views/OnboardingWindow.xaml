<Window x:Class="Humanesque.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Humanesque Typer — Initial Setup" 
        Height="540" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="✨ Welcome to Humanesque Typer" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBlock Text="Configure your default typing speed or take a quick 15-second typing test to calibrate the engine to your natural cadence." 
                       FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Body / Options -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="CHOOSE YOUR BASE PROFILE:" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentPrimary}" Margin="0,0,0,14"/>

                <RadioButton x:Name="RadioSlow" Content="Slow Typer (~30 WPM) — High hesitation, relaxed pauses, 2.8% typo rate" 
                             Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,12"/>
                <RadioButton x:Name="RadioAverage" Content="Average Typer (~60 WPM) — Conversational cadence, natural rhythm (Recommended)" 
                             IsChecked="True" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,12"/>
                <RadioButton x:Name="RadioFast" Content="Fast Typer (~95 WPM) — Snappy muscle-memory bursts, 0.9% typo rate" 
                             Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,0,0,20"/>

                <Separator Background="{StaticResource BorderDark}" Margin="0,0,0,16"/>

                <TextBlock Text="OPTIONAL: 15-SECOND CALIBRATION TEST" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <TextBlock Text="Type the sample sentence below. We'll measure your speed and error rate to build a customized profile." 
                           FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>

                <Border Background="{StaticResource BgDark}" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtSample" Text="The quick brown fox jumps over the lazy dog while typing in the background with natural cadence." 
                               Foreground="{StaticResource TextSecondary}" FontStyle="Italic" FontSize="13" TextWrapping="Wrap"/>
                </Border>

                <TextBox x:Name="TxtTestInput" Height="60" TextWrapping="Wrap" AcceptsReturn="False" 
                         TextChanged="OnTestInputChanged" ToolTip="Type the sample text here to measure your cadence"/>

                <TextBlock x:Name="TxtCalibrationStatus" Text="Status: Waiting for input..." 
                           Foreground="{StaticResource StatusSuccess}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer / Finish Button -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Hotkeys: F8 = Pause/Resume | F9 = Abort | Ctrl+Shift+T = Lock Active" 
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontSize="11"/>

            <Button Grid.Column="1" Content="Get Started →" Click="OnFinishClicked" 
                    Background="{StaticResource AccentPrimary}" FontSize="14" Padding="24,10"/>
        </Grid>
    </Grid>
</Window>
