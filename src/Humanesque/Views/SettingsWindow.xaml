<Window x:Class="Humanesque.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Humanesque Settings &amp; Profile Tuning" 
        Height="580" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDark}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ Profile Tuning &amp; Settings" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Target WPM Slider -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Speed (WPM):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderWpm, Path=Value, StringFormat={}{0:F0} WPM}" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                    </Grid>
                    <Slider x:Name="SliderWpm" Minimum="20" Maximum="140" Value="62" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,18"/>

                    <!-- Typo Rate % Slider -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Typo Probability (%):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderTypo, Path=Value, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="{StaticResource StatusWarning}"/>
                    </Grid>
                    <Slider x:Name="SliderTypo" Minimum="0.0" Maximum="8.0" Value="1.6" TickFrequency="0.2" IsSnapToTickEnabled="True" Margin="0,0,0,18"/>

                    <!-- Reaction Delay Ms Slider -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Typo Realization Hesitation (ms):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderReaction, Path=Value, StringFormat={}{0:F0} ms}" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                    <Slider x:Name="SliderReaction" Minimum="100" Maximum="800" Value="320" TickFrequency="25" IsSnapToTickEnabled="True" Margin="0,0,0,18"/>

                    <!-- Sentence Pause Ms Slider -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Period / Sentence Pause (ms):" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=SliderPeriod, Path=Value, StringFormat={}{0:F0} ms}" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                    </Grid>
                    <Slider x:Name="SliderPeriod" Minimum="150" Maximum="1500" Value="550" TickFrequency="50" IsSnapToTickEnabled="True" Margin="0,0,0,18"/>

                    <!-- Options -->
                    <Separator Background="{StaticResource BorderDark}" Margin="0,4,0,14"/>

                    <CheckBox x:Name="ChkFloatingPill" Content="Show discreet floating progress pill during background typing" 
                              IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkSound" Content="Play subtle audio chime when background typing completes" 
                              IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="OnCancelClicked" Background="{StaticResource BgCardHover}" Padding="16,8" Margin="0,0,10,0"/>
            <Button Content="Save Settings" Click="OnSaveClicked" Background="{StaticResource AccentPrimary}" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
