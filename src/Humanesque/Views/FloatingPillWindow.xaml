<Window x:Class="Humanesque.Views.FloatingPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Humanesque Live Status" 
        Height="48" Width="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        MouseLeftButtonDown="OnDragWindow">

    <Border Background="#E61C1C21" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="24" Padding="12,6" Opacity="0.94">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="⌨️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <ProgressBar x:Name="PillProgressBar" Height="4" Value="45" Maximum="100" 
                             Background="#2E2E38" Foreground="#6366F1" BorderThickness="0" Margin="0,0,0,3"/>
                <TextBlock x:Name="PillStatusText" Text="62.4 WPM | 45%" FontSize="10" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2" Content="✕" Click="OnCloseClicked" 
                    Background="Transparent" Foreground="#94A3B8" FontSize="11" Margin="8,0,0,0" Padding="4,2"/>
        </Grid>
    </Border>
</Window>
